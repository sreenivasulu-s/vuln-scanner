import asyncio
from uuid import uuid4

from fastapi import BackgroundTasks, FastAPI, HTTPException, Query
from pydantic import BaseModel, field_validator


app = FastAPI(
    title="Authorized Web Security Scanner",
    version="0.7.0"
)


class ScanRequest(BaseModel):
    url: str

    @field_validator("url")
    @classmethod
    def validate_url(cls, value: str) -> str:
        value = value.strip()

        if not (
            value.startswith("http://")
            or value.startswith("https://")
        ):
            raise ValueError(
                "URL must start with http:// or https://"
            )

        return value


class Finding(BaseModel):
    title: str
    severity: str
    description: str
    evidence: str
    tool: str

    @field_validator("severity")
    @classmethod
    def validate_severity(cls, value: str) -> str:
        allowed = {
            "info",
            "low",
            "medium",
            "high",
            "critical"
        }

        value = value.lower().strip()

        if value not in allowed:
            raise ValueError(
                "Severity must be info, low, medium, high, or critical"
            )

        return value


scans = {}


def add_finding(
    scan_id: str,
    title: str,
    severity: str,
    description: str,
    evidence: str,
    tool: str
):
    finding = Finding(
        title=title,
        severity=severity,
        description=description,
        evidence=evidence,
        tool=tool
    )

    scans[scan_id]["findings"].append(
        finding.model_dump()
    )


async def run_scan(scan_id: str):
    scans[scan_id]["status"] = "running"

    await asyncio.sleep(5)

    add_finding(
        scan_id=scan_id,
        title="Demo low finding",
        severity="low",
        description="This is a test low-severity finding.",
        evidence="Demo evidence only",
        tool="demo"
    )

    add_finding(
        scan_id=scan_id,
        title="Demo medium finding",
        severity="medium",
        description="This is a test medium-severity finding.",
        evidence="Demo evidence only",
        tool="demo"
    )

    add_finding(
        scan_id=scan_id,
        title="Demo info finding",
        severity="info",
        description="This is informational test data.",
        evidence="Demo evidence only",
        tool="demo"
    )

    scans[scan_id]["status"] = "completed"


@app.get("/")
def home():
    return {
        "status": "ok",
        "message": "Security Scanner API is running"
    }


@app.post("/scan")
async def start_scan(
    request: ScanRequest,
    background_tasks: BackgroundTasks
):
    scan_id = str(uuid4())

    scans[scan_id] = {
        "scan_id": scan_id,
        "target": request.url,
        "status": "queued",
        "findings": []
    }

    background_tasks.add_task(run_scan, scan_id)

    return scans[scan_id]


@app.get("/scan/{scan_id}")
def get_scan(scan_id: str):
    scan = scans.get(scan_id)

    if not scan:
        raise HTTPException(
            status_code=404,
            detail="Scan ID not found"
        )

    return scan


@app.get("/scan/{scan_id}/findings")
def get_findings(
    scan_id: str,
    severity: str | None = Query(default=None)
):
    scan = scans.get(scan_id)

    if not scan:
        raise HTTPException(
            status_code=404,
            detail="Scan ID not found"
        )

    findings = scan["findings"]

    if severity is not None:
        severity = severity.lower().strip()

        allowed = {
            "info",
            "low",
            "medium",
            "high",
            "critical"
        }

        if severity not in allowed:
            raise HTTPException(
                status_code=400,
                detail="Invalid severity"
            )

        findings = [
            finding
            for finding in findings
            if finding["severity"] == severity
        ]

    return {
        "scan_id": scan_id,
        "count": len(findings),
        "findings": findings
    }
