import asyncio
from uuid import uuid4

from fastapi import BackgroundTasks, FastAPI, HTTPException, Query
from pydantic import BaseModel, field_validator

from scanner.lab_scanner import LabScanner


app = FastAPI(
    title="Authorized Web Security Scanner",
    version="0.7.0",
)


class ScanRequest(BaseModel):
    url: str

    @field_validator("url")
    @classmethod
    def validate_url(cls, value: str) -> str:
        value = value.strip()

        if not (
            value.startswith("http://")
            or value.startswith("https://")
        ):
            raise ValueError(
                "URL must start with http:// or https://"
            )

        return value


class Finding(BaseModel):
    title: str
    severity: str
    description: str
    evidence: str
    tool: str

    @field_validator("severity")
    @classmethod
    def validate_severity(cls, value: str) -> str:
        allowed = {
            "info",
            "low",
            "medium",
            "high",
            "critical",
        }

        if value not in allowed:
            raise ValueError(
                "Invalid severity. "
                "Allowed values: info, low, medium, high, critical"
            )

        return value


scans = {}


def add_finding(
    scan_id: str,
    title: str,
    severity: str,
    description: str,
    evidence: str,
    tool: str,
):
    finding = Finding(
        title=title,
        severity=severity,
        description=description,
        evidence=evidence,
        tool=tool,
    )

    scans[scan_id]["findings"].append(
        finding.model_dump()
    )


async def run_scan(scan_id: str):
    scans[scan_id]["status"] = "running"

    try:
        target = scans[scan_id]["target"]

        scanner = LabScanner()
        results = await scanner.scan(target)

        scans[scan_id]["findings"] = []

        for result in results:
            finding = Finding.model_validate(result)

            add_finding(
                scan_id,
                finding.title,
                finding.severity,
                finding.description,
                finding.evidence,
                finding.tool,
            )

        scans[scan_id]["status"] = "completed"

    except Exception as exc:
        scans[scan_id]["status"] = "failed"
        scans[scan_id]["error"] = str(exc)


@app.get("/")
def home():
    return {
        "status": "ok",
        "message": "Security Scanner API is running",
    }


@app.post("/scan")
def start_scan(
    request: ScanRequest,
    background_tasks: BackgroundTasks,
):
    print("DEBUG URL:", repr(request.url))

    scan_id = str(uuid4())

    scans[scan_id] = {
        "scan_id": scan_id,
        "target": request.url,
        "status": "queued",
        "findings": [],
    }

    background_tasks.add_task(
        run_scan,
        scan_id,
    )

    return scans[scan_id]


@app.get("/scan/{scan_id}")
def get_scan(scan_id: str):
    if scan_id not in scans:
        raise HTTPException(
            status_code=404,
            detail="Scan ID not found",
        )

    return scans[scan_id]


@app.get("/scan/{scan_id}/findings")
def get_findings(
    scan_id: str,
    severity: str | None = Query(default=None),
):
    if scan_id not in scans:
        raise HTTPException(
            status_code=404,
            detail="Scan ID not found",
        )

    findings = scans[scan_id]["findings"]

    if severity is not None:
        findings = [
            finding
            for finding in findings
            if finding["severity"] == severity
        ]

    return {
        "scan_id": scan_id,
        "count": len(findings),
        "findings": findings,
    }
