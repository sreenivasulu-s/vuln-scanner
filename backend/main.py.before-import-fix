@field_validator("url")
@classmethod
def validate_url(cls, value: str) -> str:
    value = value.strip()

    if not (
        value.startswith("http://")
        or value.startswith("https://")
    ):
        raise ValueError(
            "URL must start with http:// or https://"
        )

    if any(char in value for char in "[]()"):
        raise ValueError(
            "URL must be a plain URL, not a Markdown link"
        )

    return value
